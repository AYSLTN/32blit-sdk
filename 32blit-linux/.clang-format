# Proposed SPS Linux-port coding style.
# Based on the existing 32blit-linux source. Confirm with the team before
# treating this as the project's official formatting standard.
BasedOnStyle: LLVM
Language: Cpp
IndentWidth: 2
ContinuationIndentWidth: 4
NamespaceIndentation: All
UseTab: Never
ColumnLimit: 120
BreakBeforeBraces: Attach
SpaceBeforeParens: Never
PointerAlignment: Right
DerivePointerAlignment: false
SortIncludes: Never
ReflowComments: false
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
